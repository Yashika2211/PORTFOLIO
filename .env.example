# Public site URL (used for metadata, sitemap and OG tags)
NEXT_PUBLIC_SITE_URL=https://yashika-bhatia.vercel.app

# Contact form — a Formspree form endpoint. Leave empty to fall back to mailto.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# --- Y.A.S.H.U. (all optional, all server-side only) ---
# Premium voice: "elevenlabs" or "openai". Without a key, the browser voice is used.
TTS_PROVIDER=
TTS_API_KEY=
# Optional voice id/name for the provider (ElevenLabs voice id, or OpenAI voice name).
TTS_VOICE=
# Anthropic API key for /api/ask free-form answers. Without it, the intent router answers.
LLM_API_KEY=

# Optional: raises the server-side GitHub API limit for /api/github.
GITHUB_TOKEN=
